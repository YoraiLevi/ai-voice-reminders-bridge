# Radicale config for the phone bridge — a tiny self-hosted CalDAV server that
# hosts the "Claude Inbox" / "Claude Output" VTODO lists WITHOUT iCloud/CloudKit.
# Both the iPhone (Reminders → Add CalDAV Account) and the Windows bridge read and
# write the SAME collections here, so the CloudKit two-store split never applies.
#
# Paths below are RELATIVE; run_radicale.py chdir's to this directory first so they
# resolve against radicale/. Both _secrets/ (auth) and _data/ (the collections) are
# git-ignored — nothing here is committed.
#
# Launch with:  uv run run_radicale.py     (from radicale/)
# Full docs:    docs at https://radicale.org/v3.html#configuration

[server]
# Bind to ALL interfaces (incl. the tailscale0 adapter) on a fixed port so the
# phone can reach it over the tailnet from anywhere, not just the LAN.
# 0.0.0.0 = every IPv4 interface; the tailnet IP (100.x) is one of them.
hosts = 0.0.0.0:5232
# Plain HTTP on the wire — fine here because the ONLY reachable path is the
# encrypted WireGuard tailnet (see OWNER-SETUP.md "Reachability"). Do NOT expose
# this port to the public internet without TLS.
max_connections = 20

[auth]
# One user, password-protected. The htpasswd file is generated by make_user.py
# (bcrypt-hashed; never a plaintext password in git). See OWNER-SETUP.md step 2.
type = htpasswd
htpasswd_filename = _secrets/users
htpasswd_encryption = bcrypt

[rights]
# Each authenticated user owns only their own collections. Single-user here, so
# this just means "must log in to touch anything".
type = owner_only

[storage]
# The actual VTODO data (the reminder lists) live here as .ics files on disk.
filesystem_folder = _data/collections

[logging]
# Log to stderr at info level so `uv run run_radicale.py` shows requests live.
level = info
